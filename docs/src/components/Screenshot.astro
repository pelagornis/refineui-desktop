---
/**
 * Renders the gallery screenshot of one component story.
 * Files come from `scripts/screenshots.sh`: src/assets/components/<id>-light.png / -dark.png.
 * Captures are 2x; they are displayed at half their pixel width.
 * When a capture is missing, a labelled placeholder is shown instead.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  alt?: string;
}

const { id, alt = `${id} component` } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/components/*.png', { eager: true });
const find = (mode: 'light' | 'dark') => images[`../assets/components/${id}-${mode}.png`]?.default;
const light = find('light');
const dark = find('dark') ?? light;
---

<figure class="rui-shot not-content">
  {
    light && dark ? (
      <>
        <Image class="rui-shot-light" src={light} alt={alt} width={Math.round(light.width / 2)} />
        <Image class="rui-shot-dark" src={dark} alt={alt} width={Math.round(dark.width / 2)} />
      </>
    ) : (
      <div class="rui-shot-placeholder">
        Screenshot pending for <code>{id}</code>
        <br />
        Run <code>./scripts/screenshots.sh {id}</code> to capture it.
      </div>
    )
  }
  <figcaption>Captured from the <code>{id}</code> story in the gallery.</figcaption>
</figure>

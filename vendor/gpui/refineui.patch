+    float4 sampled = refine_blur_sample(t, p, frag / ds - p->misc.yz);
+    float alpha = sampled.a;
+    float3 rgb = sampled.rgb / max(alpha, 0.0001);
+
+    float luma = dot(rgb, float3(0.2126, 0.7152, 0.0722));
+    rgb = max(mix(float3(luma), rgb, p->extra.x), float3(0.0));
+
+    float4 tint = p->tint;
+    rgb = mix(rgb, refine_blend_tint(saturate(rgb), tint.rgb, p->light_color.w), tint.a);
+    float out_alpha = alpha + tint.a * (1.0 - alpha);
+
+    float3 light = p->light_color.rgb;
+    float2 dir = p->light_dir.xy;
+    float2 half_size = shape.zw * 0.5;
+    float2 local = (frag - (shape.xy + half_size)) / max(half_size, float2(1.0));
+    bool has_dir = dot(dir, dir) > 0.0;
+    if (p->light_dir.z > 0.0 && has_dir) {
+      float g = clamp(dot(local, dir), -1.0, 1.0);
+      float lit = p->light_dir.z * smoothstep(-0.2, 1.0, g);
+      rgb = refine_screen(rgb, light * lit);
+      rgb = rgb * (1.0 - p->light_dir.z * 0.35 * smoothstep(0.0, 1.0, -g));
+    }
+    if (p->light_dir.w > 0.0) {
+      rgb = refine_screen(rgb, light * p->light_dir.w);
+    }
+    if (p->light_b.z > 0.0) {
+      float2 r = float2(0.70710677, -0.70710677);
+      if (has_dir) {
+        r = normalize(dir + float2(-dir.y, dir.x));
+      }
+      float tt = dot(local, r);
+      float u = (tt - 0.42) / 0.26;
+      float band = exp(-u * u);
+      rgb = refine_screen(rgb, light * (p->light_b.z * band));
+    }
+    if (p->light_a.z > 0.0) {
+      float2 spot = shape.xy + p->light_b.xy * shape.zw;
+      float spot_size = max(p->light_a.w, 1.0);
+      float2 d = frag - spot;
+      float spec = exp(-dot(d, d) / (2.0 * spot_size * spot_size));
+      rgb = refine_screen(rgb, light * (p->light_a.z * spec));
+    }
+    if (p->light_a.x > 0.0) {
+      float width = max(p->light_a.y, 0.5);
+      float rim = exp(-max(-distance, 0.0) / width);
+      float facing = 1.0;
+      if (has_dir) {
+        float2 n = refine_rrect_normal(frag, shape, p->radii);
+        facing = 0.3 + 0.7 * max(dot(n, dir), 0.0);
+      }
+      rgb = refine_screen(rgb, light * (p->light_a.x * rim * facing));
+    }
+
+    float grain = (refine_hash(frag, 1u) - 0.5) * 2.0 * p->light_b.w;
+    float dither = (refine_hash(frag, 2u) - refine_hash(frag, 3u)) / 255.0;
+    rgb = saturate(rgb + float3(grain + dither));
+
+    float mask = 1.0;
+    if (dot(p->mask.xy, p->mask.xy) > 0.0) {
+      float tm = dot((frag - shape.xy) / max(shape.zw, float2(1.0)) - float2(0.5), p->mask.xy) + 0.5;
+      mask = saturate((p->mask.w - tm) / max(p->mask.w - p->mask.z, 0.0001));
+    }
+    float a = out_alpha * coverage * opacity * mask;
+    plate = float4(rgb * a, a);
+  }
+
+  float4 shadow = float4(0.0);
+  int count = int(p->misc.x);
+  for (int i = 0; i < 4; i++) {
+    if (i >= count) {
+      break;
+    }
+    float4 geometry = p->shadows[i * 2];
+    float4 color = p->shadows[i * 2 + 1];
+    float spread = geometry.w;
+    float4 rect = float4(shape.xy + geometry.xy - float2(spread), shape.zw + float2(spread * 2.0));
+    float4 radii = max(p->radii + float4(spread), float4(0.0));
+    float a = refine_shadow_alpha(frag, rect, radii, geometry.z) * color.a;
+    shadow = float4(color.rgb * a, a) + shadow * (1.0 - a);
+  }
+  shadow = shadow * ((1.0 - coverage) * opacity);
+
+  float4 result = plate + shadow * (1.0 - plate.a);
+  if (p->extra.z > 0.5) {
+    return result;
+  }
+  return float4(result.rgb / max(result.a, 0.0001), result.a);
+}

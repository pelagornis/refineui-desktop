+  float4 position [[position]];
+};
+
+constexpr sampler refine_blur_sampler(mag_filter::linear, min_filter::linear,
+                                      address::clamp_to_edge);
+
+vertex RefineBlurVarying refine_blur_vertex(
+    uint vertex_id [[vertex_id]],
+    constant RefineBlurParams *p [[buffer(0)]]) {
+  float2 unit = float2(float(vertex_id & 1u), float((vertex_id >> 1u) & 1u));
+  float2 position = p->dst_rect.xy + unit * p->dst_rect.zw;
+  float2 ndc = position / p->target_size.xy * float2(2.0, -2.0) + float2(-1.0, 1.0);
+  return RefineBlurVarying{float4(ndc, 0.0, 1.0)};
+}
+
+float4 refine_blur_sample(texture2d<float> t, constant RefineBlurParams *p,
+                          float2 position) {
+  float2 c = clamp(position, p->src_clamp.xy + float2(0.5), p->src_clamp.zw - float2(0.5));
+  return t.sample(refine_blur_sampler, c * p->src_size.zw, level(0.0));
+}
+
+fragment float4 refine_blur_downsample_fragment(
+    RefineBlurVarying input [[stage_in]],
+    constant RefineBlurParams *p [[buffer(0)]],
+    texture2d<float> t [[texture(0)]]) {
+  float scale = p->params.x;
+  float2 center = input.position.xy * scale;
+  if (scale < 2.0) {
+    return refine_blur_sample(t, p, center);
+  }
+  int n = int(scale * 0.5);
+  float4 acc = float4(0.0);
+  for (int j = 0; j < n; j++) {
+    for (int i = 0; i < n; i++) {
+      float2 offset = float2(float(i) * 2.0 + 1.0, float(j) * 2.0 + 1.0) - float2(scale * 0.5);
+      acc += refine_blur_sample(t, p, center + offset);
+    }
+  }
+  return acc / float(n * n);
+}
+
+fragment float4 refine_blur_gaussian_fragment(
+    RefineBlurVarying input [[stage_in]],
+    constant RefineBlurParams *p [[buffer(0)]],
+    texture2d<float> t [[texture(0)]]) {
+  float sigma = max(p->params.y, 0.0001);
+  float2 dir = p->params.zw;
+  int taps = int(min(ceil(sigma * 3.0), 64.0));
+  float k = -0.5 / (sigma * sigma);
+  float4 acc = refine_blur_sample(t, p, input.position.xy);
+  float total = 1.0;
+  for (int i = 1; i <= taps; i++) {
+    float x = float(i);
+    float w = exp(x * x * k);
+    acc += w * (refine_blur_sample(t, p, input.position.xy + dir * x) +
+                refine_blur_sample(t, p, input.position.xy - dir * x));
+    total += 2.0 * w;
+  }
+  return acc / total;
+}
+
+float refine_corner_radius(float2 to_point, float4 radii) {
+  return to_point.x < 0.0 ? (to_point.y < 0.0 ? radii.x : radii.w)
+                          : (to_point.y < 0.0 ? radii.y : radii.z);
+}
+
+// Signed distance to a rounded rectangle (x, y, w, h) — negative inside.
+float refine_rrect_distance(float2 position, float4 rect, float4 radii) {
+  float2 half_size = rect.zw * 0.5;
+  float2 to_point = position - (rect.xy + half_size);
+  float radius = min(refine_corner_radius(to_point, radii), min(half_size.x, half_size.y));
+  float2 q = abs(to_point) - half_size + float2(radius);
+  return length(max(q, float2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
+}
+
+float2 refine_rrect_normal(float2 position, float4 rect, float4 radii) {
+  float2 half_size = rect.zw * 0.5;
+  float2 to_point = position - (rect.xy + half_size);
+  float radius = min(refine_corner_radius(to_point, radii), min(half_size.x, half_size.y));
+  float2 q = abs(to_point) - half_size + float2(radius);
+  float2 s = select(float2(-1.0), float2(1.0), to_point >= float2(0.0));
+  if (q.x > 0.0 && q.y > 0.0) {
+    return normalize(q) * s;
+  }
+  if (q.x > q.y) {
+    return float2(s.x, 0.0);
+  }
+  return float2(0.0, s.y);
+}
+
+// Coverage of a blurred rounded rectangle (gpui's shadow model).
+float refine_shadow_alpha(float2 position, float4 rect, float4 radii, float sigma) {
+  if (sigma < 0.5) {
+    return saturate(0.5 - refine_rrect_distance(position, rect, radii));
+  }
+  float2 half_size = rect.zw * 0.5;
+  float2 to_point = position - (rect.xy + half_size);
+  float corner = min(refine_corner_radius(to_point, radii), min(half_size.x, half_size.y));
+  float low = to_point.y - half_size.y;
+  float high = to_point.y + half_size.y;
+  float start = clamp(-3.0 * sigma, low, high);
+  float end = clamp(3.0 * sigma, low, high);
+  float dy = (end - start) / 4.0;
+  float y = start + dy * 0.5;
+  float alpha = 0.0;
+  for (int i = 0; i < 4; i++) {
+    alpha += blur_along_x(to_point.x, to_point.y - y, sigma, corner, half_size) *
+             gaussian(y, sigma) * dy;
+    y += dy;
+  }
+  return saturate(alpha);
+}
+
+float refine_hash(float2 p, uint seed) {
+  uint x = uint(p.x) * 1664525u + uint(p.y) * 1013904223u + seed * 2654435761u;
+  x ^= x >> 16u;
+  x *= 0x7feb352du;
+  x ^= x >> 15u;
+  x *= 0x846ca68bu;
+  x ^= x >> 16u;
+  return float(x) * (1.0 / 4294967295.0);
+}
+
+float3 refine_screen(float3 a, float3 b) {
+  return float3(1.0) - (float3(1.0) - a) * (float3(1.0) - b);
+}
+
+float3 refine_blend_tint(float3 base, float3 tint, float mode) {
+  if (mode < 0.5) {
+    return tint;
+  }
+  if (mode < 1.5) {
+    return base * tint;
+  }
+  if (mode < 2.5) {
+    return refine_screen(base, tint);
+  }
+  if (mode < 3.5) {
+    float3 low = 2.0 * base * tint;
+    float3 high = float3(1.0) - 2.0 * (float3(1.0) - base) * (float3(1.0) - tint);
+    return select(high, low, base <= float3(0.5));
+  }
+  float3 d = select(sqrt(base), ((16.0 * base - 12.0) * base + 4.0) * base, base <= float3(0.25));
+  float3 soft_low = base - (float3(1.0) - 2.0 * tint) * base * (float3(1.0) - base);
+  float3 soft_high = base + (2.0 * tint - float3(1.0)) * (d - base);
+  return select(soft_high, soft_low, tint <= float3(0.5));
+}
+
+fragment float4 refine_blur_composite_fragment(
+    RefineBlurVarying input [[stage_in]],
+    constant RefineBlurParams *p [[buffer(0)]],
+    texture2d<float> t [[texture(0)]]) {

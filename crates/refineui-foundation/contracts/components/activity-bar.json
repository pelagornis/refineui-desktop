{
  "$schema": "../schema.json",
  "id": "activity-bar",
  "name": "Activity Bar",
  "layer": "application",
  "status": "new",
  "phase": 2,
  "feature": null,
  "desktop_target": "Activity Bar / Navigation Rail",
  "rust_types": [
    "ActivityBar",
    "ActivityDrag"
  ],
  "a11y_role": "navigation",
  "states": {
    "default": {
      "status": "implemented",
      "visual": "resting tokens"
    },
    "hovered": {
      "status": "implemented",
      "visual": "row plate backgroundPrimaryHover (pointer)"
    },
    "pressed": {
      "status": "planned",
      "visual": "row plate backgroundPrimaryActive"
    },
    "focused": {
      "status": "implemented",
      "visual": "keyboard cursor row plate + focusRing on the container"
    },
    "disabled": {
      "status": "implemented",
      "visual": "row foregroundDisabled, skipped by arrows"
    },
    "loading": {
      "status": "planned",
      "visual": "skeleton rows / trailing spinner"
    },
    "selected": {
      "status": "implemented",
      "visual": "selected plate (backgroundPrimaryHover / surfaceSelected) + medium weight"
    },
    "dragging": {
      "status": "implemented",
      "visual": "row lifts (dragPreview layer); drop indicator between rows"
    }
  },
  "sizes": {
    "metric": "desktop",
    "compact": {
      "row_height": 26,
      "tree_row_height": 22,
      "tab_height": 28,
      "toolbar_height": 32,
      "status_bar_height": 22,
      "panel_header_height": 28,
      "activity_bar_width": 40,
      "activity_item": 32,
      "panel_padding": 8,
      "gap": 4,
      "icon": 16,
      "splitter_hit": 4
    },
    "comfortable": {
      "row_height": 32,
      "tree_row_height": 28,
      "tab_height": 36,
      "toolbar_height": 40,
      "status_bar_height": 24,
      "panel_header_height": 36,
      "activity_bar_width": 48,
      "activity_item": 36,
      "panel_padding": 10,
      "gap": 6,
      "icon": 16,
      "splitter_hit": 6
    },
    "spacious": {
      "row_height": 40,
      "tree_row_height": 32,
      "tab_height": 40,
      "toolbar_height": 48,
      "status_bar_height": 28,
      "panel_header_height": 44,
      "activity_bar_width": 56,
      "activity_item": 44,
      "panel_padding": 16,
      "gap": 8,
      "icon": 20,
      "splitter_hit": 8
    }
  },
  "tokens": {
    "color": [
      "backgroundBrand",
      "backgroundBrandSubtle",
      "backgroundPrimary",
      "backgroundPrimaryHover",
      "borderDefault",
      "borderFocus",
      "borderSubtle",
      "foregroundBrand",
      "foregroundDisabled",
      "foregroundOnBrand",
      "foregroundPrimary",
      "foregroundSecondary",
      "foregroundTertiary",
      "surfaceSunken"
    ],
    "radius": [
      "roundedLarge",
      "roundedSmall",
      "roundedXxLarge"
    ],
    "spacing": [
      "sizeMedium",
      "sizeXSmall",
      "sizeXxSmall",
      "sizeXxxSmall"
    ],
    "typography": [
      "bodySm",
      "captionLg",
      "captionSm"
    ],
    "motion": [
      "motion.fast",
      "motion.indicator",
      "motion.medium"
    ],
    "stroke": [
      "strokeWidthHairline",
      "strokeWidthThick",
      "strokeWidthThin"
    ]
  },
  "keyboard": [
    {
      "keys": "down",
      "action": "next item"
    },
    {
      "keys": "up",
      "action": "previous item"
    },
    {
      "keys": "enter",
      "action": "activate item"
    },
    {
      "keys": "alt-up",
      "action": "move item up"
    },
    {
      "keys": "alt-down",
      "action": "move item down"
    }
  ],
  "focus": {
    "tab_stop": "roving",
    "ring": "focusRing",
    "restores_focus": false
  },
  "pointer": {
    "cursor": "default",
    "hover_only": false
  }
}

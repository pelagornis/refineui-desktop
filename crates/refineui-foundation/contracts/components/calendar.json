{
  "$schema": "../schema.json",
  "id": "calendar",
  "name": "Calendar",
  "layer": "components",
  "status": "exists",
  "phase": 4,
  "feature": null,
  "desktop_target": null,
  "rust_types": [
    "Calendar"
  ],
  "a11y_role": "grid",
  "states": {
    "default": {
      "status": "implemented",
      "visual": "resting tokens"
    },
    "hovered": {
      "status": "implemented",
      "visual": "day plate backgroundPrimaryHover / foregroundPrimaryHover (pointer)"
    },
    "pressed": {
      "status": "implemented",
      "visual": "day plate backgroundPrimaryActive, scale 0.96"
    },
    "focused": {
      "status": "implemented",
      "visual": "focusRing on the focused day (keyboard focus only)"
    },
    "disabled": {
      "status": "planned",
      "visual": "day foregroundDisabled, not clickable"
    },
    "loading": {
      "status": "planned",
      "visual": "skeleton rows / trailing spinner"
    },
    "selected": {
      "status": "implemented",
      "visual": "backgroundBrand + foregroundInversed (range: endpoint band and middle days backgroundPrimaryHover)"
    },
    "dragging": {
      "status": "planned",
      "visual": "row lifts (dragPreview layer); drop indicator between rows"
    }
  },
  "sizes": {
    "metric": "fixed"
  },
  "tokens": {
    "color": [
      "backgroundBrand",
      "backgroundPrimary",
      "backgroundPrimaryActive",
      "backgroundPrimaryHover",
      "borderDefault",
      "borderFocus",
      "foregroundDisabled",
      "foregroundInversed",
      "foregroundPrimary",
      "foregroundPrimaryHover"
    ],
    "radius": [
      "roundedLarge",
      "roundedXxLarge"
    ],
    "spacing": [
      "sizeMedium",
      "sizeSmall",
      "sizeXxLarge",
      "sizeXxSmall",
      "sizeXxxSmall"
    ],
    "typography": [
      "captionLg",
      "subtitleMd"
    ]
  },
  "keyboard": [
    {
      "keys": "enter",
      "action": "choose the focused day"
    },
    {
      "keys": "space",
      "action": "choose the focused day"
    }
  ],
  "focus": {
    "tab_stop": "roving",
    "ring": "focusRing",
    "restores_focus": false
  },
  "pointer": {
    "cursor": "default",
    "hover_only": false
  }
}
